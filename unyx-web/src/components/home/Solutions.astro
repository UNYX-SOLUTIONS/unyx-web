---
const groups = [
  {
    title: "DIGITAL",
    services: [
      {
        number: "01",
        icon: "code",
        title: "Desarrollo de software",
        description:
          "Aplicaciones, plataformas y soluciones digitales adaptadas a cada operación.",
        href: "/soluciones/desarrollo-software",
      },
      {
        number: "02",
        icon: "nodes",
        title: "CRM y automatización comercial",
        description:
          "Organizamos procesos comerciales, seguimiento y atención mediante plataformas conectadas.",
        href: "/soluciones/crm-automatizacion-comercial",
      },
      {
        number: "03",
        icon: "automation",
        title: "Automatización e IA",
        description:
          "Reducimos tareas manuales mediante flujos automatizados y soluciones inteligentes.",
        href: "/soluciones/automatizacion-ia",
      },
      {
        number: "04",
        icon: "integration",
        title: "Integraciones y APIs",
        description:
          "Conectamos sistemas y plataformas para que la información fluya automáticamente.",
        href: "/soluciones/integraciones-apis",
      },
    ],
  },
  {
    title: "INFRAESTRUCTURA",
    services: [
      {
        number: "05",
        icon: "support",
        title: "Soporte y gestión tecnológica",
        description:
          "Administración, mantenimiento y soporte de equipos, usuarios y entornos tecnológicos.",
        href: "/soluciones/soporte-gestion-tecnologica",
      },
      {
        number: "06",
        icon: "network",
        title: "Infraestructura y redes",
        description:
          "Diseñamos e implementamos conectividad e infraestructura para operaciones confiables.",
        href: "/soluciones/infraestructura-redes",
      },
      {
        number: "07",
        icon: "cloud",
        title: "Cloud, datos y continuidad",
        description:
          "Servicios cloud, almacenamiento, respaldo y administración de información empresarial.",
        href: "/soluciones/cloud-datos-continuidad",
      },
    ],
  },
  {
    title: "INDUSTRIA",
    services: [
      {
        number: "08",
        icon: "industry",
        title: "IoT y automatización industrial",
        description:
          "Conectamos sensores, dispositivos, equipos y datos para digitalizar procesos físicos.",
        href: "/soluciones/iot-automatizacion-industrial",
      },
      {
        number: "09",
        icon: "otit",
        title: "Integración OT / IT",
        description:
          "Integramos sistemas operacionales e industriales con plataformas digitales y datos empresariales.",
        href: "/soluciones/integracion-ot-it",
      },
    ],
  },
];
---

<section class="solutions" id="soluciones">
  <div class="solutions__container">

    <header class="solutions__header">
      <div class="solutions__heading">

        <div class="solutions__eyebrow">
          <span class="solutions__eyebrow-line"></span>
          <span>NUESTRAS SOLUCIONES</span>
        </div>

        <h2>
          Un solo aliado para<br />
          conectar tecnología y<br />
          operación.
        </h2>

        <p class="solutions__lead">
          Combinamos diferentes capacidades tecnológicas para diseñar soluciones
          que respondan a la realidad de cada operación.
        </p>

      </div>
    </header>

    <div class="solutions__groups">
      {
        groups.map((group) => (
          <section class="solution-group">

            <div class="solution-group__heading">
              <h3>{group.title}</h3>

              <div class="solution-group__line">
                <span></span>
                <span></span>
              </div>
            </div>

            <div class="solution-group__cards">
              {
                group.services.map((service) => (
                  <a
                    class="service-card"
                    href={service.href}
                    aria-label={`Conocer más sobre ${service.title}`}
                  >
                    <div class="service-card__top">

                      <div class="service-card__meta">

                        <span
                          class="service-card__icon"
                          aria-hidden="true"
                        >
                          {service.icon === "code" && (
                            <svg viewBox="0 0 24 24">
                              <path d="M8 9 5 12l3 3M16 9l3 3-3 3" />
                            </svg>
                          )}

                          {service.icon === "nodes" && (
                            <svg viewBox="0 0 24 24">
                              <circle cx="12" cy="5" r="2" />
                              <circle cx="5" cy="12" r="2" />
                              <circle cx="19" cy="12" r="2" />
                              <circle cx="12" cy="19" r="2" />
                              <path d="M10.5 6.5 6.5 10.5M13.5 6.5l4 4M6.5 13.5l4 4M17.5 13.5l-4 4" />
                            </svg>
                          )}

                          {service.icon === "automation" && (
                            <svg viewBox="0 0 24 24">
                              <path d="M8 17a5 5 0 1 1 8 0M9 17h6M12 3v3M5 7l2 2M19 7l-2 2" />
                            </svg>
                          )}

                          {service.icon === "integration" && (
                            <svg viewBox="0 0 24 24">
                              <path d="M7 7h4v4H7zM13 13h4v4h-4zM11 9h3a2 2 0 0 1 2 2v2M13 15h-3a2 2 0 0 1-2-2v-2" />
                            </svg>
                          )}

                          {service.icon === "support" && (
                            <svg viewBox="0 0 24 24">
                              <path d="M5 13v-2a7 7 0 0 1 14 0v2M5 13h3v5H5zM16 13h3v5h-3zM16 18c0 2-1 3-4 3" />
                            </svg>
                          )}

                          {service.icon === "network" && (
                            <svg viewBox="0 0 24 24">
                              <path d="M12 4v5M6 20v-5h12v5M6 15v-3h12v3M12 9v3" />
                              <circle cx="12" cy="3" r="1.5" />
                              <circle cx="6" cy="21" r="1.5" />
                              <circle cx="18" cy="21" r="1.5" />
                            </svg>
                          )}

                          {service.icon === "cloud" && (
                            <svg viewBox="0 0 24 24">
                              <path d="M7 18h10a4 4 0 0 0 .5-8 6 6 0 0 0-11-1A4.5 4.5 0 0 0 7 18Z" />
                            </svg>
                          )}

                          {service.icon === "industry" && (
                            <svg viewBox="0 0 24 24">
                              <path d="M4 19h16M6 19V9l4 3V8l4 3V6l4 3v10" />
                            </svg>
                          )}

                          {service.icon === "otit" && (
                            <svg viewBox="0 0 24 24">
                              <path d="M6 4v16M12 4v16M18 4v16M4 8h4M10 14h4M16 10h4" />
                            </svg>
                          )}
                        </span>

                        <span class="service-card__number">
                          {service.number}
                        </span>

                      </div>

                      <span
                        class="service-card__arrow"
                        aria-hidden="true"
                      >
                        →
                      </span>

                    </div>

                    <h4>{service.title}</h4>

                    <p>{service.description}</p>

                  </a>
                ))
              }
            </div>

          </section>
        ))
      }
    </div>

    <div
      class="solutions__connection"
      aria-hidden="true"
    >

      <div class="solutions__connection-line solutions__connection-line--left"></div>
      <div class="solutions__connection-line solutions__connection-line--center"></div>
      <div class="solutions__connection-line solutions__connection-line--right"></div>

      <span class="solutions__connection-dot solutions__connection-dot--left"></span>
      <span class="solutions__connection-dot solutions__connection-dot--center"></span>
      <span class="solutions__connection-dot solutions__connection-dot--right"></span>

      <div class="solutions__core">

        <div class="solutions__core-grid">
          <span></span>
          <span></span>
          <span></span>
          <span class="is-active"></span>
        </div>

        <small>
          UNYX CORE
        </small>

      </div>
    </div>

  </div>
</section>

<style>
  .solutions {
    position: relative;

    width: 100%;

    background: #ffffff;
    color: #0a0a0c;
  }

  .solutions__container {
    width: min(100%, 1440px);

    margin: 0 auto;

    padding:
      56px
      clamp(32px, 5vw, 64px)
      82px;
  }

  /* =========================================================
     HEADER
     ========================================================= */

  .solutions__header {
    margin-bottom: 58px;
  }

  .solutions__heading {
    max-width: 760px;
  }

  .solutions__eyebrow {
    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 25px;

    color: #075cff;

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .solutions__eyebrow-line {
    position: relative;

    width: 24px;
    height: 1px;

    background: #075cff;
  }

  .solutions__eyebrow-line::before {
    content: "";

    position: absolute;

    left: -2px;
    top: 50%;

    width: 4px;
    height: 4px;

    border-radius: 50%;

    background: #075cff;

    transform: translateY(-50%);
  }

  .solutions__heading h2 {
    margin: 0;

    color: #0a0a0c;

    font-size: clamp(40px, 3.8vw, 58px);

    font-weight: 700;

    line-height: 1.02;

    letter-spacing: -0.045em;
  }

  .solutions__lead {
    max-width: 620px;

    margin: 24px 0 0;

    color: #343a46;

    font-size: 14px;

    line-height: 1.65;
  }

  /* =========================================================
     GROUPS
     ========================================================= */

  .solutions__groups {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 18px;
  }

  .solution-group {
    min-width: 0;
  }

  .solution-group__heading {
    margin-bottom: 18px;
  }

  .solution-group__heading h3 {
    margin: 0 0 14px;

    color: #0a0a0c;

    font-size: 16px;

    font-weight: 700;

    letter-spacing: -0.02em;
  }

  .solution-group__line {
    position: relative;

    width: 100%;
    height: 1px;

    background: #dfe3e9;
  }

  .solution-group__line span {
    position: absolute;

    top: 50%;

    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: #075cff;

    transform: translateY(-50%);
  }

  .solution-group__line span:first-child {
    left: 0;
  }

  .solution-group__line span:last-child {
    right: 0;
  }

  /* =========================================================
     CARDS
     ========================================================= */

  .solution-group__cards {
    display: flex;

    flex-direction: column;

    gap: 12px;
  }

  .service-card {
    min-height: 145px;

    display: block;

    padding: 18px 18px 20px;

    border: 1px solid #e1e4e9;

    border-radius: 10px;

    background: #ffffff;

    color: inherit;

    text-decoration: none;

    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .service-card__top {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 14px;

    margin-bottom: 14px;
  }

  .service-card__meta {
    display: inline-flex;

    align-items: center;

    gap: 9px;
  }

  .service-card__icon {
    width: 18px;
    height: 18px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    color: #075cff;
  }

  .service-card__icon svg {
    width: 100%;
    height: 100%;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.7;

    stroke-linecap: round;

    stroke-linejoin: round;
  }

  .service-card__number {
    color: #3e4653;

    font-size: 10px;

    font-weight: 700;

    line-height: 1;
  }

  .service-card__arrow {
    color: #666d78;

    font-size: 18px;

    transition:
      transform 180ms ease,
      color 180ms ease;
  }

  .service-card h4 {
    margin: 0 0 10px;

    color: #0a0a0c;

    font-size: 14px;

    font-weight: 700;

    line-height: 1.3;

    letter-spacing: -0.015em;
  }

  .service-card p {
    max-width: 100%;

    margin: 0;

    color: #505762;

    font-size: 12px;

    line-height: 1.55;
  }

  @media (hover: hover) {
    .service-card:hover {
      border-color: #bfc5ce;

      background: #fcfcfd;

      transform: translateY(-2px);

      box-shadow:
        0 10px 30px
        rgba(12, 20, 38, 0.045);
    }

    .service-card:hover .service-card__arrow {
      color: #075cff;

      transform: translateX(4px);
    }
  }

  /* =========================================================
     CONNECTION SYSTEM
     ========================================================= */

  .solutions__connection {
    position: relative;

    height: 102px;

    margin-top: 0;
  }

  .solutions__connection-line {
    position: absolute;

    top: 0;

    height: 40px;

    border-bottom: 1px solid #e1e4e9;
  }

  .solutions__connection-line--left {
    left: 16.66%;

    width: 33.34%;
  }

  .solutions__connection-line--center {
    left: 50%;

    width: 1px;

    height: 68px;

    border: none;

    background: #e1e4e9;
  }

  .solutions__connection-line--right {
    left: 50%;

    width: 33.34%;
  }

  .solutions__connection-dot {
    position: absolute;

    top: 37px;

    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: #075cff;

    transform: translate(-50%, -50%);
  }

  .solutions__connection-dot--left {
    left: 16.66%;
  }

  .solutions__connection-dot--center {
    left: 50%;
  }

  .solutions__connection-dot--right {
    left: 83.34%;
  }

  .solutions__core {
    position: absolute;

    left: 50%;
    bottom: 0;

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 6px;

    transform: translateX(-50%);
  }

  .solutions__core-grid {
    width: 22px;
    height: 22px;

    display: grid;

    grid-template-columns:
      repeat(2, 1fr);

    gap: 2px;
  }

  .solutions__core-grid span {
    border: 1px solid #bfc5ce;

    background: #f5f6f8;
  }

  .solutions__core-grid .is-active {
    border-color: #075cff;

    background: #075cff;
  }

  .solutions__core small {
    color: #075cff;

    font-size: 7px;

    font-weight: 700;

    letter-spacing: 0.12em;
  }

  /* =========================================================
     TABLET
     ========================================================= */

  @media (max-width: 980px) {
    .solutions__container {
      padding:
        48px
        28px
        72px;
    }

    .solutions__groups {
      grid-template-columns: 1fr;

      gap: 42px;
    }

    .solution-group__cards {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .solutions__connection {
      display: none;
    }
  }

  /* =========================================================
     MOBILE
     ========================================================= */

  @media (max-width: 620px) {
    .solutions__container {
      padding:
        44px
        20px
        68px;
    }

    .solutions__heading h2 br {
      display: none;
    }

    .solutions__heading h2 {
      font-size: clamp(38px, 11vw, 50px);
    }

    .solutions__header {
      margin-bottom: 50px;
    }

    .solution-group__cards {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: auto;

      padding:
        18px
        16px
        19px;
    }
  }
</style>