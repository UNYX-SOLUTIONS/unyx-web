---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout title="Página no encontrada | UNYX Solutions" noindex>
  <main>
    <section class="relative flex min-h-svh items-center overflow-hidden bg-black text-white">
      <div class="relative z-[2] site-container pt-[100px] pb-[80px] text-center">
        <span class="block text-[11px] font-bold uppercase tracking-[0.08em] text-blue">
          ERROR 404
        </span>

        <h1 class="mt-6 text-[clamp(40px,5vw,64px)] font-bold leading-[1.02] tracking-[-0.045em] text-white">
          Página no encontrada
        </h1>

        <p class="mx-auto mt-6 max-w-[480px] text-base leading-[1.65] text-gray-500">
          La página que buscas no existe o fue movida.
        </p>

        <Button href="/" variant="primary" class="mt-9">
          Volver al inicio
        </Button>
      </div>
    </section>
  </main>
</BaseLayout>
