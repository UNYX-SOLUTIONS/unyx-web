---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";
import ProjectChallenge from "../../components/projects/ProjectChallenge.astro";
import ProjectSolution from "../../components/projects/ProjectSolution.astro";
import ProjectResults from "../../components/projects/ProjectResults.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"projects"> };
const { Content } = await render(entry);
---

<ProjectLayout
  title={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  number={entry.data.number}
>
  <ProjectChallenge content={entry.data.challenge} />
  <ProjectSolution content={entry.data.solution} />
  <ProjectResults content={entry.data.results} />

  <section class="w-full bg-white text-black">
    <div class="mx-auto w-full max-w-[1440px] px-[clamp(32px,5vw,64px)] py-[70px]">
      <div class="article-body mx-auto max-w-3xl">
        <Content />
      </div>
    </div>
  </section>
</ProjectLayout>
