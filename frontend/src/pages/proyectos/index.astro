---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectsHero from "../../components/projects/ProjectsHero.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";

const projects = (await getCollection("projects")).sort((a, b) =>
  a.data.number.localeCompare(b.data.number)
);
---

<BaseLayout
  title="Proyectos | UNYX Solutions"
  description="Cada proyecto parte de una necesidad diferente. Nuestro trabajo es entenderla y construir la solución tecnológica adecuada."
>
  <main>
    <ProjectsHero />

    <section class="w-full bg-white text-black">
      <div class="site-container py-[70px]">
        <div class="grid grid-cols-3 gap-6 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1">
          {
            projects.map((entry) => (
              <ProjectCard entry={entry} />
            ))
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
