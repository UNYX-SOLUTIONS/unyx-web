---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Política de privacidad | UNYX Solutions"
  description="Política de privacidad de UNYX Solutions."
  noindex
>
  <main>
    <section class="relative overflow-hidden bg-black text-white">
      <div class="relative z-[2] mx-auto w-full max-w-[1440px] px-[clamp(32px,5vw,64px)] pt-[170px] pb-[70px]">
        <span class="block text-[11px] font-bold uppercase tracking-[0.08em] text-blue">
          LEGAL
        </span>

        <h1 class="mt-6 text-[clamp(36px,4vw,54px)] font-bold leading-[1.04] tracking-[-0.045em] text-white">
          Política de privacidad
        </h1>
      </div>
    </section>

    <section class="w-full bg-white text-black">
      <div class="mx-auto w-full max-w-[1440px] px-[clamp(32px,5vw,64px)] py-[70px]">
        <div class="mx-auto max-w-3xl">
          <p class="text-base leading-[1.65] text-gray-700">
            Este documento está en revisión y será publicado próximamente.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
