---
import "../styles/global.css";

import SEO from "../components/global/SEO.astro";
import Header from "../components/global/Header.astro";
import MobileMenu from "../components/global/MobileMenu.astro";
import Footer from "../components/global/Footer.astro";
import Analytics from "../components/global/Analytics.astro";

import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, DEFAULT_OG_IMAGE } from "../consts";

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  canonical = SITE_URL,
  image = DEFAULT_OG_IMAGE,
  noindex = false,
  showHeader = true,
  showFooter = true,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      noindex={noindex}
    />

    <slot name="head" />
  </head>

  <body>
    {showHeader && <Header />}
    {showHeader && <MobileMenu />}

    <slot />

    {showFooter && <Footer />}

    <Analytics />
  </body>
</html>
