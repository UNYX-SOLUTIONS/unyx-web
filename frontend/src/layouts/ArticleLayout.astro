---
import BaseLayout from "./BaseLayout.astro";
import JsonLd from "../components/global/JsonLd.astro";
import { articleSchema, breadcrumbListSchema } from "../utils/schema";

const {
  title = "",
  description = "",
  category = "",
  type = "",
  slug = "",
  pubDate,
} = Astro.props;

const breadcrumb = breadcrumbListSchema([
  { name: "Inicio", path: "/" },
  { name: "Insights", path: "/insights" },
  { name: title, path: `/insights/${slug}` },
]);

const article = pubDate
  ? articleSchema({
      title,
      description,
      category,
      href: `/insights/${slug}`,
      pubDate,
    })
  : null;
---

<BaseLayout title={title} description={description}>
  <JsonLd slot="head" schema={breadcrumb} />
  {article && <JsonLd slot="head" schema={article} />}

  <main>
    <section class="relative overflow-hidden bg-black text-white">
      <div class="relative z-[2] site-container pt-[170px] pb-[70px]">
        <div class="flex gap-2.5 text-[11px] font-semibold text-gray-500">
          {category && <span class="font-bold text-blue-light">{category}</span>}
          {category && type && <span>·</span>}
          {type && <span>{type}</span>}
        </div>

        <h1 class="mt-6 max-w-[850px] text-[clamp(36px,4vw,58px)] font-bold leading-[1.04] tracking-[-0.045em] text-white">
          {title}
        </h1>

        {description && (
          <p class="mt-6 max-w-[620px] text-base leading-[1.65] text-gray-500">
            {description}
          </p>
        )}
      </div>
    </section>

    <section class="w-full bg-white text-black">
      <div class="site-container py-[70px]">
        <div class="mx-auto max-w-3xl">
          <slot />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
