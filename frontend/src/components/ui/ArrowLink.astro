---
const {
  href = "#",
  class: className = "",
} = Astro.props;
---

<a href={href} class:list={["group inline-flex items-center gap-2.5 text-xs font-semibold transition-colors duration-180", className]}>
  <slot />
  <span class="transition-transform duration-180 group-hover:translate-x-1" aria-hidden="true">→</span>
</a>
