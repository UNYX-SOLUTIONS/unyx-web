---
const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  type = "button",
} = Astro.props;

const variantClasses = {
  primary: "bg-blue text-white hover:bg-blue-hover",
  secondary: "bg-transparent text-black border-gray-300 hover:border-black",
  "dark-secondary": "bg-transparent text-white border-white/25 hover:border-white/60",
};

const sizeClasses = {
  sm: "px-[18px] py-3 text-sm",
  md: "px-[22px] py-[15px] text-base",
  lg: "px-7 py-[18px] text-lg",
};

const classes = [
  "inline-flex items-center justify-center gap-2.5 min-h-12 border border-transparent rounded-lg font-semibold leading-none transition-[background-color,color,border-color,transform] duration-[160ms] hover:-translate-y-px",
  variantClasses[variant],
  sizeClasses[size],
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes}>
      <slot />
    </button>
  )
}
