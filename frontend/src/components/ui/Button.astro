---
const {
  href,
  variant = "primary",
  class: className = "",
  type = "button",
  dataAnalytics,
} = Astro.props;

const variantClasses = {
  primary:
    "gap-4 min-h-13.5 rounded-lg border border-blue bg-blue px-6 text-sm font-semibold leading-none text-white hover:border-blue-hover hover:bg-blue-hover",
  secondary:
    "min-h-13.5 rounded-lg border border-gray-300 bg-transparent px-6 text-sm font-semibold leading-none text-black hover:border-black",
  "dark-secondary":
    "min-h-13.5 rounded-lg border border-gray-700 bg-transparent px-6 text-sm font-semibold leading-none text-white hover:border-gray-500 hover:bg-white/[0.035]",
  "dark-primary":
    "gap-6 rounded-md bg-blue px-6 py-4.5 text-[13px] font-bold text-white hover:bg-blue-hover",
  compact:
    "rounded-lg bg-blue px-5 py-3.25 text-sm font-semibold text-white hover:bg-blue-hover",
};

const classes = [
  "group inline-flex items-center justify-center transition-[background-color,border-color,color,transform] duration-180 hover:-translate-y-0.5 disabled:opacity-60",
  variantClasses[variant],
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} data-analytics={dataAnalytics}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} data-analytics={dataAnalytics}>
      <slot />
    </button>
  )
}
