---
import { CONTACT_EMAIL, CONTACT_LOCATION } from "../../consts";
import { company } from "../../data/company";
import {
  footerColumns,
  footerSideColumns,
  footerLegal,
} from "../../data/navigation";

const linkClasses =
  "text-xs leading-[1.45] text-[#b0b5bd] transition-[color,transform] duration-[160ms] hover:text-white hover:translate-x-0.5";
---

<footer class="w-full bg-black text-white border-t border-[#1c1e22]">
  <div
    class="site-container pt-[38px] pb-[18px] max-[620px]:px-5 max-[620px]:pt-[38px] max-[620px]:pb-5"
  >
    <!-- =====================================================
         MAIN FOOTER
         ===================================================== -->

    <div
      class="grid grid-cols-[minmax(270px,1.3fr)_minmax(230px,1fr)_minmax(150px,0.65fr)_minmax(140px,0.55fr)]
      gap-[clamp(50px,6vw,90px)]
      pb-8
      max-[1000px]:grid-cols-2
      max-[620px]:grid-cols-1
      max-[620px]:gap-9
      max-[620px]:pb-8"
    >
      <!-- ===================================================
           BRAND
           =================================================== -->

      <div>
        <a
          href="/"
          class="inline-flex items-center"
          aria-label="UNYX Solutions - Inicio"
        >
          <img
            src="/logos/unyx-logo-white.png"
            alt="UNYX Solutions"
            class="h-10 w-auto object-contain"
            loading="lazy"
            decoding="async"
          />
        </a>

        <p class="mt-4 max-w-80 text-[12px] leading-[1.65] text-[#9ea4ad]">
          {company.description}
        </p>

        <div class="flex flex-col gap-[7px] mt-6 text-[12px] max-[1000px]:mt-6">
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="text-white transition-opacity duration-160 hover:opacity-75"
          >
            {CONTACT_EMAIL}
          </a>

          <span class="text-[#858b95]">
            {CONTACT_LOCATION}
          </span>
        </div>
      </div>

      <!-- ===================================================
           FOOTER COLUMNS
           =================================================== -->

      {
        footerColumns.map((column) => (
          <nav
            class="flex flex-col items-start gap-3"
            aria-label={column.ariaLabel}
          >
            <h2 class="mb-2 text-[15px]! font-bold! tracking-[0.04em]! text-white">
              {column.title}
            </h2>

            {column.links.map((link) => (
              <a href={link.href} class={linkClasses}>
                {link.label}
              </a>
            ))}
          </nav>
        ))
      }

      <!-- ===================================================
           SIDE COLUMNS
           =================================================== -->

      <div
        class="flex flex-col justify-between gap-9 max-[1000px]:justify-start"
      >
        {
          footerSideColumns.map((column) => (
            <nav
              class="flex flex-col items-start gap-3"
              aria-label={column.ariaLabel}
            >
              <h2 class="mb-2 text-[15px]! font-bold! tracking-[0.04em]! text-white">
                {column.title}
              </h2>

              {column.links.map((link) => (
                <a
                  href={link.href}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  class={linkClasses}
                >
                  {link.label}

                  {link.external && (
                    <span
                      class="ml-1 text-[9px] text-[#6d737d]"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  )}
                </a>
              ))}
            </nav>
          ))
        }
      </div>
    </div>

    <!-- =====================================================
         LEGAL
         ===================================================== -->

    <div
      class="flex items-center justify-between gap-8
      pt-4
      border-t border-[#1e2025]
      text-[10px]
      text-[#767c86]
      max-[620px]:flex-col
      max-[620px]:items-start
      max-[620px]:gap-4"
    >
      <span> © 2026 UNYX Solutions. Todos los derechos reservados. </span>

      <nav
        class="flex gap-[26px]
        max-[620px]:flex-wrap
        max-[620px]:gap-x-[22px]
        max-[620px]:gap-y-3"
        aria-label="Legal"
      >
        {
          footerLegal.map((link) => (
            <a
              href={link.href}
              class="text-[#858b94] transition-colors duration-[160ms] hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
