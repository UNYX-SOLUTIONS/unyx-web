---
import { SITE_TITLE, CONTACT_EMAIL, CONTACT_LOCATION } from "../../consts";
import { company } from "../../data/company";
import { footerColumns, footerSideColumns, footerLegal } from "../../data/navigation";

const linkClasses =
  "text-xs leading-[1.45] text-[#9da2ab] transition-[color,transform] duration-[160ms] hover:text-white hover:translate-x-0.5";
---

<footer class="w-full bg-black text-white border-t border-[#1c1e22]">
  <div class="mx-auto w-full max-w-[1440px] px-[clamp(32px,5vw,64px)] pt-[66px] pb-[30px] max-[620px]:px-5 max-[620px]:pt-[54px] max-[620px]:pb-[26px]">

    <div class="grid grid-cols-[minmax(270px,1.3fr)_minmax(230px,1fr)_minmax(150px,0.65fr)_minmax(140px,0.55fr)] gap-[clamp(50px,6vw,90px)] pb-[62px] max-[1000px]:grid-cols-2 max-[620px]:grid-cols-1 max-[620px]:gap-11 max-[620px]:pb-12">

      <div>

        <a
          href="/"
          class="inline-flex items-center gap-3 text-white"
          aria-label={SITE_TITLE}
        >
          <span
            class="grid w-5 h-5 grid-cols-2 gap-0.5"
            aria-hidden="true"
          >
            <span class="bg-transparent border border-[#5a606a]"></span>
            <span class="bg-transparent border border-[#5a606a]"></span>
            <span class="bg-transparent border border-[#5a606a]"></span>
            <span class="bg-[#075cff] border border-[#075cff]"></span>
          </span>

          <strong class="text-[19px] font-bold">
            {SITE_TITLE}
          </strong>
        </a>

        <p class="mt-[22px] max-w-80 text-[13px] leading-[1.7] text-[#999fa9]">
          {company.description}
        </p>

        <div class="flex flex-col gap-[7px] mt-[52px] text-[13px] max-[1000px]:mt-9">

          <a href={`mailto:${CONTACT_EMAIL}`} class="text-white">
            {CONTACT_EMAIL}
          </a>

          <span class="text-[#999fa9]">
            {CONTACT_LOCATION}
          </span>

        </div>

      </div>

      {
        footerColumns.map((column) => (
          <nav
            class="flex flex-col items-start gap-3.25"
            aria-label={column.ariaLabel}
          >
            <h2 class="mb-2 text-[15px]! font-bold! tracking-[0.04em]! text-white">
              {column.title}
            </h2>

            {
              column.links.map((link) => (
                <a href={link.href} class={linkClasses}>
                  {link.label}
                </a>
              ))
            }
          </nav>
        ))
      }

      <div class="flex flex-col justify-between gap-[55px] max-[1000px]:justify-start">

        {
          footerSideColumns.map((column) => (
            <nav
              class="flex flex-col items-start gap-[13px]"
              aria-label={column.ariaLabel}
            >
              <h2 class="mb-2 text-[15px]! font-bold! tracking-[0.04em]! text-white">
                {column.title}
              </h2>

              {
                column.links.map((link) => (
                  <a
                    href={link.href}
                    rel={link.external ? "noopener noreferrer" : undefined}
                    class={linkClasses}
                  >
                    {link.label}
                  </a>
                ))
              }
            </nav>
          ))
        }

      </div>

    </div>

    <div class="flex items-center justify-between gap-8 pt-[26px] border-t border-[#1e2025] text-[10px] text-[#7f858e] max-[620px]:flex-col max-[620px]:items-start">

      <span>
        © 2026 UNYX Solutions. Todos los derechos reservados.
      </span>

      <nav class="flex gap-[26px] max-[620px]:flex-wrap max-[620px]:gap-x-[22px] max-[620px]:gap-y-3" aria-label="Legal">

        {
          footerLegal.map((link) => (
            <a href={link.href} class="text-[#858b94] transition-colors duration-[160ms] hover:text-white">
              {link.label}
            </a>
          ))
        }

      </nav>

    </div>

  </div>
</footer>
