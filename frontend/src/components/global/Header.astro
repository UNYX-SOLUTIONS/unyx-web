---
import { SITE_TITLE } from "../../consts";
import { headerNav, headerCta } from "../../data/navigation";
import Button from "../ui/Button.astro";
---

<header class="absolute top-0 left-0 z-[100] w-full text-white border-b border-white/[0.08]">
  <div class="grid w-[min(calc(100%-48px),1280px)] h-[84px] mx-auto grid-cols-[1fr_auto_1fr] items-center gap-10 max-[800px]:grid-cols-[1fr_auto]">

    <a href="/" class="text-xl font-bold text-white">
      {SITE_TITLE}
    </a>

    <nav class="flex gap-[34px] max-[800px]:hidden">
      {
        headerNav.map((item) => (
          <a href={item.href} class="text-sm text-gray-400 hover:text-white">
            {item.label}
          </a>
        ))
      }
    </nav>

    <Button
      href={headerCta.href}
      variant="compact"
      class="justify-self-end"
      dataAnalytics="header_cta_click"
    >
      {headerCta.label}
    </Button>

  </div>
</header>
