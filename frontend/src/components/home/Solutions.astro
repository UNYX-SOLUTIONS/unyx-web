---
import { serviceGroups } from "../../data/services";
---

<section class="relative w-full bg-white text-black" id="soluciones">
  <div class="site-container pt-14 pb-[82px] max-[980px]:px-7 max-[980px]:pt-12 max-[980px]:pb-[72px] max-[620px]:px-5 max-[620px]:pt-11 max-[620px]:pb-[68px]">

    <header class="mb-[58px] max-[620px]:mb-[50px]">
      <div class="max-w-[760px]">

        <div class="mb-[25px] flex items-center gap-3 text-xs font-bold uppercase tracking-[0.08em] text-blue">
          <span class="relative h-px w-6 bg-blue before:absolute before:-left-0.5 before:top-1/2 before:h-1 before:w-1 before:-translate-y-1/2 before:rounded-full before:bg-blue before:content-['']"></span>
          <span>NUESTRAS SOLUCIONES</span>
        </div>

        <h2 class="text-[clamp(40px,3.8vw,58px)] font-bold leading-[1.02] tracking-[-0.045em] text-black max-[620px]:text-[clamp(38px,11vw,50px)]">
          Un solo aliado para<br class="max-[620px]:hidden" />
          conectar tecnología y<br class="max-[620px]:hidden" />
          operación.
        </h2>

        <p class="mt-6 max-w-[620px] text-sm leading-[1.65] text-gray-700">
          Combinamos diferentes capacidades tecnológicas para diseñar soluciones
          que respondan a la realidad de cada operación.
        </p>

      </div>
    </header>

    <div class="grid grid-cols-3 gap-[18px] max-[980px]:grid-cols-1 max-[980px]:gap-[42px]">
      {
        serviceGroups.map((group) => (
          <section class="min-w-0">

            <div class="mb-[18px]">
              <h3 class="mb-[14px] text-base font-bold tracking-[-0.02em] text-black">{group.title}</h3>

              <div class="relative h-px w-full bg-gray-200">
                <span class="absolute left-0 top-1/2 h-[5px] w-[5px] -translate-y-1/2 rounded-full bg-blue"></span>
                <span class="absolute right-0 top-1/2 h-[5px] w-[5px] -translate-y-1/2 rounded-full bg-blue"></span>
              </div>
            </div>

            <div class="flex flex-col gap-3 max-[980px]:grid max-[980px]:grid-cols-2 max-[620px]:grid-cols-1">
              {
                group.services.map((service) => (
                  <a
                    class="block min-h-[145px] rounded-[10px] border border-gray-200 bg-white p-[18px_18px_20px] text-inherit transition-[border-color,background-color,transform,box-shadow] duration-[180ms] hover:-translate-y-0.5 hover:border-gray-300 hover:bg-gray-100 hover:shadow-[0_10px_30px_rgba(12,20,38,0.045)] max-[620px]:min-h-0 max-[620px]:p-[18px_16px_19px]"
                    href={service.href}
                  >
                    <div class="mb-[14px] flex items-center justify-between gap-3.5">

                      <div class="inline-flex items-center gap-2">

                        <span
                          class="inline-flex h-[18px] w-[18px] items-center justify-center text-blue"
                          aria-hidden="true"
                        >
                          {service.icon === "code" && (
                            <svg viewBox="0 0 24 24" class="h-full w-full fill-none stroke-current [stroke-width:1.7] [stroke-linecap:round] [stroke-linejoin:round]">
                              <path d="M8 9 5 12l3 3M16 9l3 3-3 3" />
                            </svg>
                          )}

                          {service.icon === "nodes" && (
                            <svg viewBox="0 0 24 24" class="h-full w-full fill-none stroke-current [stroke-width:1.7] [stroke-linecap:round] [stroke-linejoin:round]">
                              <circle cx="12" cy="5" r="2" />
                              <circle cx="5" cy="12" r="2" />
                              <circle cx="19" cy="12" r="2" />
                              <circle cx="12" cy="19" r="2" />
                              <path d="M10.5 6.5 6.5 10.5M13.5 6.5l4 4M6.5 13.5l4 4M17.5 13.5l-4 4" />
                            </svg>
                          )}

                          {service.icon === "automation" && (
                            <svg viewBox="0 0 24 24" class="h-full w-full fill-none stroke-current [stroke-width:1.7] [stroke-linecap:round] [stroke-linejoin:round]">
                              <path d="M8 17a5 5 0 1 1 8 0M9 17h6M12 3v3M5 7l2 2M19 7l-2 2" />
                            </svg>
                          )}

                          {service.icon === "integration" && (
                            <svg viewBox="0 0 24 24" class="h-full w-full fill-none stroke-current [stroke-width:1.7] [stroke-linecap:round] [stroke-linejoin:round]">
                              <path d="M7 7h4v4H7zM13 13h4v4h-4zM11 9h3a2 2 0 0 1 2 2v2M13 15h-3a2 2 0 0 1-2-2v-2" />
                            </svg>
                          )}

                          {service.icon === "support" && (
                            <svg viewBox="0 0 24 24" class="h-full w-full fill-none stroke-current [stroke-width:1.7] [stroke-linecap:round] [stroke-linejoin:round]">
                              <path d="M5 13v-2a7 7 0 0 1 14 0v2M5 13h3v5H5zM16 13h3v5h-3zM16 18c0 2-1 3-4 3" />
                            </svg>
                          )}

                          {service.icon === "network" && (
                            <svg viewBox="0 0 24 24" class="h-full w-full fill-none stroke-current [stroke-width:1.7] [stroke-linecap:round] [stroke-linejoin:round]">
                              <path d="M12 4v5M6 20v-5h12v5M6 15v-3h12v3M12 9v3" />
                              <circle cx="12" cy="3" r="1.5" />
                              <circle cx="6" cy="21" r="1.5" />
                              <circle cx="18" cy="21" r="1.5" />
                            </svg>
                          )}

                          {service.icon === "cloud" && (
                            <svg viewBox="0 0 24 24" class="h-full w-full fill-none stroke-current [stroke-width:1.7] [stroke-linecap:round] [stroke-linejoin:round]">
                              <path d="M7 18h10a4 4 0 0 0 .5-8 6 6 0 0 0-11-1A4.5 4.5 0 0 0 7 18Z" />
                            </svg>
                          )}

                          {service.icon === "industry" && (
                            <svg viewBox="0 0 24 24" class="h-full w-full fill-none stroke-current [stroke-width:1.7] [stroke-linecap:round] [stroke-linejoin:round]">
                              <path d="M4 19h16M6 19V9l4 3V8l4 3V6l4 3v10" />
                            </svg>
                          )}

                          {service.icon === "otit" && (
                            <svg viewBox="0 0 24 24" class="h-full w-full fill-none stroke-current [stroke-width:1.7] [stroke-linecap:round] [stroke-linejoin:round]">
                              <path d="M6 4v16M12 4v16M18 4v16M4 8h4M10 14h4M16 10h4" />
                            </svg>
                          )}
                        </span>

                        <span class="text-[10px] font-bold leading-none text-gray-700">
                          {service.number}
                        </span>

                      </div>

                      <span
                        class="text-lg text-gray-600 transition-[transform,color] duration-[180ms] group-hover:translate-x-1 group-hover:text-blue"
                        aria-hidden="true"
                      >
                        →
                      </span>

                    </div>

                    <h4 class="mb-2.5 text-sm font-bold leading-[1.3] tracking-[-0.015em] text-black">{service.title}</h4>

                    <p class="max-w-full text-xs leading-[1.55] text-gray-700">{service.description}</p>

                  </a>
                ))
              }
            </div>

          </section>
        ))
      }
    </div>

    <div
      class="relative h-[102px] max-[980px]:hidden"
      aria-hidden="true"
    >

      <div class="absolute left-[16.66%] top-0 h-10 w-[33.34%] border-b border-gray-200"></div>
      <div class="absolute left-1/2 top-0 h-[68px] w-px bg-gray-200"></div>
      <div class="absolute left-1/2 top-0 h-10 w-[33.34%] border-b border-gray-200"></div>

      <span class="absolute left-[16.66%] top-[37px] h-[5px] w-[5px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue"></span>
      <span class="absolute left-1/2 top-[37px] h-[5px] w-[5px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue"></span>
      <span class="absolute left-[83.34%] top-[37px] h-[5px] w-[5px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue"></span>

      <div class="absolute bottom-0 left-1/2 flex -translate-x-1/2 flex-col items-center gap-1.5">

        <div class="grid h-[22px] w-[22px] grid-cols-2 gap-0.5">
          <span class="border border-gray-300 bg-gray-100"></span>
          <span class="border border-gray-300 bg-gray-100"></span>
          <span class="border border-gray-300 bg-gray-100"></span>
          <span class="border border-blue bg-blue"></span>
        </div>

        <small class="text-[7px] font-bold tracking-[0.12em] text-blue">
          UNYX CORE
        </small>

      </div>
    </div>

  </div>
</section>
