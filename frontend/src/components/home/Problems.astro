---
import ArrowLink from "../ui/ArrowLink.astro";
import SectionLabel from "../ui/SectionLabel.astro";

const problems = [
  {
    number: "01",
    title: "Procesos manuales",
    description:
      "Tareas repetitivas que consumen tiempo y dependen demasiado de intervención humana.",
  },
  {
    number: "02",
    title: "Información dispersa",
    description:
      "Datos repartidos entre Excel, WhatsApp, correos y diferentes plataformas.",
  },
  {
    number: "03",
    title: "Falta de seguimiento",
    description:
      "Clientes, oportunidades y tareas que se pierden por falta de visibilidad y control.",
  },
  {
    number: "04",
    title: "Sistemas aislados",
    description:
      "Herramientas que funcionan por separado y obligan a repetir información entre plataformas.",
  },
  {
    number: "05",
    title: "Datos sin aprovechar",
    description:
      "Información disponible que no se convierte fácilmente en decisiones o acciones.",
  },
  {
    number: "06",
    title: "Tecnología difícil",
    description:
      "Equipos, usuarios e infraestructura que requieren demasiado tiempo para mantenerse funcionando correctamente.",
  },
];
---

<section class="relative w-full bg-white text-black" id="problema">
  <div class="site-container pt-[clamp(90px,9vw,145px)] pb-9 max-[900px]:px-7 max-[900px]:pt-22.5 max-[900px]:pb-8 max-[600px]:px-5 max-[600px]:pt-18 max-[600px]:pb-7">

    <div class="grid grid-cols-[minmax(0,1.55fr)_minmax(260px,0.85fr)] items-end gap-[clamp(60px,10vw,160px)] mb-[clamp(60px,6vw,78px)] max-[900px]:grid-cols-1 max-[900px]:items-start max-[900px]:gap-8 max-[600px]:mb-11.5">
      <div class="max-w-180">
        <SectionLabel class="mb-7 max-[600px]:mb-5">
          EL PROBLEMA
        </SectionLabel>

        <h2 class="text-[clamp(40px,3.8vw,58px)]! font-bold! leading-[1.02]! tracking-[-0.045em]! text-black max-[600px]:text-[clamp(38px,11vw,50px)]! max-[600px]:leading-none!">
          Cuando la tecnología no<br class="max-[900px]:hidden!" />
          está conectada, la<br class="max-[900px]:hidden!" />
          operación tampoco.
        </h2>
      </div>

      <div class="max-w-97.5! pb-2! max-[900px]:max-w-130!">
        <p class="text-[15px]! leading-[1.65] text-gray-700">
          Muchas empresas no necesitan más herramientas.
          Necesitan que sus procesos, sistemas e información
          trabajen mejor juntos.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-3 border-l border-t border-gray-200 max-[900px]:grid-cols-2! max-[600px]:grid-cols-1!">
      {
        problems.map((problem) => (
          <article class="min-h-52.5 border-b border-r border-gray-200 bg-white p-[34px_30px_38px] transition-[background-color,transform] duration-180 hover:bg-gray-100 max-[600px]:min-h-0 max-[600px]:p-[28px_24px_32px]">
            <span class="mb-6.5 block text-[27px] font-bold leading-none text-blue max-[600px]:mb-5 max-[600px]:text-2xl">
              {problem.number}
            </span>

            <h3 class="mb-4 text-base font-bold leading-tight tracking-[-0.015em] text-black">
              {problem.title}
            </h3>

            <p class="max-w-80 text-[13px] leading-[1.6] text-gray-700">
              {problem.description}
            </p>
          </article>
        ))
      }
    </div>

    <div class="flex flex-col items-center pt-11 text-center max-[600px]:pt-9.5">
      <div
        class="mb-5 h-10 w-px bg-linear-to-b from-gray-200 to-blue max-[600px]:mb-4.5 max-[600px]:h-8.5"
        aria-hidden="true"
      ></div>

      <h3 class="mb-3.5 text-[clamp(24px,2vw,30px)] font-bold leading-[1.2] tracking-[-0.03em] text-black">
        Ahí es donde entra UNYX.
      </h3>

      <ArrowLink href="#soluciones" class="text-blue">
        Conocer nuestras soluciones
      </ArrowLink>
    </div>

  </div>
</section>
