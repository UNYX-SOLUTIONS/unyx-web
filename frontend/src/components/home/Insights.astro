---
import { getCollection } from "astro:content";

const allInsights = await getCollection("insights");
const featured = allInsights.find((entry) => entry.data.featured) ?? allInsights[0];
const secondary = allInsights.filter((entry) => entry !== featured);
---

<section class="w-full bg-white text-black" id="insights">
  <div class="mx-auto w-full max-w-[1440px] px-[clamp(32px,5vw,64px)] pt-[82px] pb-[86px] max-[620px]:px-5 max-[620px]:py-[66px]">

    <header class="flex items-end justify-between gap-[60px] border-b border-gray-200 pb-[46px] max-[850px]:flex-col max-[850px]:items-start">
      <div>
        <span class="mb-5 block text-[11px] font-bold tracking-[0.08em] text-blue">
          INSIGHTS
        </span>

        <h2 class="text-[clamp(38px,3.5vw,54px)] leading-[1.05] tracking-[-0.04em] text-black">
          Ideas para tomar mejores<br />
          decisiones tecnológicas.
        </h2>

        <p class="mt-[22px] max-w-[580px] text-sm leading-[1.65] text-gray-600">
          Análisis, guías y perspectivas sobre tecnología aplicada
          a problemas reales de negocio.
        </p>
      </div>

      <a href="/insights" class="flex shrink-0 gap-2.5 text-xs font-semibold text-blue">
        Ver todos los insights
        <span>→</span>
      </a>
    </header>

    <div class="grid grid-cols-[minmax(0,1.4fr)_minmax(340px,0.9fr)] max-[850px]:grid-cols-1">

      <article class="border-r border-gray-200 p-[48px_46px_0_0] max-[850px]:border-r-0 max-[850px]:pr-0">
        <a href={`/insights/${featured.id}`} class="text-inherit">

          <div class="relative mb-[30px] h-[290px] overflow-hidden border border-gray-200 bg-[linear-gradient(#e3e6eb_1px,transparent_1px),linear-gradient(90deg,#e3e6eb_1px,transparent_1px)] bg-[length:30px_30px] max-[620px]:h-[220px]">
            <div class="absolute left-[10%] right-[10%] top-1/2 flex items-center">
              <span class="h-[7px] w-[7px] shrink-0 rounded-full bg-blue"></span>
              <span class="h-px flex-1 border-t border-dashed border-[#9fb9ec]"></span>
              <span class="h-[7px] w-[7px] shrink-0 rounded-full bg-gray-300"></span>
              <span class="h-px flex-1 border-t border-dashed border-[#9fb9ec]"></span>
              <span class="h-[7px] w-[7px] shrink-0 rounded-full bg-gray-300"></span>
              <span class="h-px flex-1 border-t border-dashed border-[#9fb9ec]"></span>
              <span class="h-[7px] w-[7px] shrink-0 rotate-45 rounded-none bg-blue"></span>
            </div>

            <div class="absolute left-[7%] right-[7%] top-[calc(50%+18px)] flex justify-between">
              <span class="border border-gray-200 bg-white px-2 py-1 text-[7px] text-gray-500">LEAD</span>
              <span class="border border-gray-200 bg-white px-2 py-1 text-[7px] text-gray-500">REGISTRO</span>
              <span class="border border-gray-200 bg-white px-2 py-1 text-[7px] text-gray-500">SEGUIMIENTO</span>
              <span class="border border-gray-200 bg-white px-2 py-1 text-[7px] text-gray-500">OPORTUNIDAD</span>
            </div>
          </div>

          <div class="mb-[14px] flex gap-2.5 text-[9px] font-semibold text-gray-500">
            <span class="font-bold text-blue">{featured.data.category}</span>
            <span>·</span>
            <span>{featured.data.type}</span>
          </div>

          <h3 class="mb-4 max-w-[620px] text-[clamp(25px,2.2vw,34px)] leading-[1.15] tracking-[-0.035em] text-black">
            {featured.data.title}
          </h3>

          <p class="max-w-[600px] text-sm leading-[1.65] text-gray-600">
            {featured.data.description}
          </p>
        </a>
      </article>

      <div class="pl-[46px] max-[850px]:pl-0">
        {
          secondary.map((insight) => (
            <article class="border-b border-gray-200 py-12">
              <a href={`/insights/${insight.id}`} class="text-inherit">

                <div class="mb-[14px] flex gap-2.5 text-[9px] font-semibold text-gray-500">
                  <span class="font-bold text-blue">{insight.data.category}</span>
                  <span>·</span>
                  <span>{insight.data.type}</span>
                </div>

                <div class="flex justify-between gap-[30px]">
                  <h3 class="mb-[14px] max-w-[430px] text-[22px] leading-[1.25] tracking-[-0.025em] text-black">
                    {insight.data.title}
                  </h3>

                  <span class="text-gray-400" aria-hidden="true">
                    ↗
                  </span>
                </div>

                <p class="max-w-[440px] text-[13px] leading-[1.65] text-gray-600">
                  {insight.data.description}
                </p>

              </a>
            </article>
          ))
        }
      </div>

    </div>

  </div>
</section>
