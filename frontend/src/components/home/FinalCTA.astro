---
import Button from "../ui/Button.astro";
---

<section class="relative w-full overflow-hidden bg-black text-white" id="contacto">
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[length:32px_32px]"
    aria-hidden="true"
  ></div>

  <div class="relative z-[2] mx-auto grid w-full max-w-[1440px] min-h-[540px] grid-cols-[minmax(0,1.1fr)_minmax(350px,0.8fr)] items-center gap-[90px] px-[clamp(32px,5vw,64px)] py-[72px] max-[850px]:grid-cols-1 max-[850px]:min-h-0 max-[850px]:gap-[45px] max-[620px]:px-5 max-[620px]:py-16">

    <div class="max-w-[650px]">

      <span class="mb-6 block text-[11px] font-bold tracking-[0.1em] text-blue-light">
        HABLEMOS
      </span>

      <h2 class="text-[clamp(44px,4.5vw,68px)] font-bold leading-none tracking-[-0.05em] text-white">
        ¿Qué quieres resolver?
      </h2>

      <p class="mt-6 max-w-[550px] text-base leading-[1.65] text-gray-500">
        Cuéntanos qué está pasando en tu operación. Podemos ayudarte a
        identificar dónde la tecnología puede generar mayor impacto.
      </p>

      <div class="mt-9 flex flex-col items-start gap-[22px]">

        <Button
          variant="dark-primary"
          href="mailto:info@unyxsolutions.com"
        >
          Cuéntanos tu proyecto

          <span class="transition-transform duration-[180ms] group-hover:translate-x-1" aria-hidden="true">
            →
          </span>
        </Button>

        <span class="text-[13px] text-gray-500">
          O escríbenos directamente:

          <a href="mailto:info@unyxsolutions.com" class="font-semibold text-white underline underline-offset-[3px]">
            info@unyxsolutions.com
          </a>
        </span>

      </div>

    </div>

    <div
      class="relative mx-auto h-80 w-[420px] max-w-full max-[850px]:w-[380px] max-[620px]:h-[250px] max-[620px]:w-[300px]"
      aria-hidden="true"
    >

      <svg
        viewBox="0 0 420 320"
        class="absolute inset-0 h-full w-full"
      >
        <line class="stroke-gray-800 stroke-1 [stroke-dasharray:5_5]" x1="210" y1="60" x2="120" y2="145" />
        <line class="stroke-gray-800 stroke-1 [stroke-dasharray:5_5]" x1="210" y1="60" x2="300" y2="145" />
        <line class="stroke-gray-800 stroke-1 [stroke-dasharray:5_5]" x1="120" y1="145" x2="210" y2="235" />
        <line class="stroke-gray-800 stroke-1 [stroke-dasharray:5_5]" x1="300" y1="145" x2="210" y2="235" />

        <path
          class="fill-none stroke-blue stroke-2"
          d="M120 145 C175 145 210 180 210 235"
        />
      </svg>

      <span class="absolute left-1/2 top-[18.75%] h-[30px] w-[30px] -translate-x-1/2 -translate-y-1/2 border border-gray-500 bg-gray-900"></span>
      <span class="absolute left-[28.5%] top-[45%] h-[30px] w-[30px] -translate-x-1/2 -translate-y-1/2 border border-gray-500 bg-gray-900"></span>
      <span class="absolute left-[71.5%] top-[45%] h-[30px] w-[30px] -translate-x-1/2 -translate-y-1/2 border border-gray-500 bg-gray-900"></span>
      <span class="absolute left-1/2 top-[73.5%] h-[30px] w-[30px] -translate-x-1/2 -translate-y-1/2 border border-blue bg-gray-900 shadow-[0_0_0_5px_rgba(7,92,255,0.12)]"></span>

    </div>

  </div>
</section>
