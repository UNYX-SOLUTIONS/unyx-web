---
import { company } from "../../data/company";

const principles = company.principles;
---

<section class="relative w-full overflow-hidden bg-black text-white [@media(min-width:1200px)_and_(min-height:760px)]:min-h-[min(100svh,900px)]" id="por-que-unyx">
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[length:32px_32px] opacity-[0.38]" aria-hidden="true"></div>

  <div class="relative z-[2] site-container pt-[54px] pb-[42px] max-[900px]:px-7 max-[900px]:pt-[60px] max-[900px]:pb-[52px] max-[620px]:px-5 max-[620px]:pt-14 max-[620px]:pb-12 [@media(min-width:1200px)_and_(min-height:760px)]:flex [@media(min-width:1200px)_and_(min-height:760px)]:min-h-[min(100svh,900px)] [@media(min-width:1200px)_and_(min-height:760px)]:flex-col [@media(min-width:1200px)_and_(min-height:760px)]:justify-center [@media(min-width:901px)_and_(max-height:850px)]:pt-10 [@media(min-width:901px)_and_(max-height:850px)]:pb-8">

    <header class="grid grid-cols-[minmax(0,1.45fr)_minmax(300px,0.65fr)] items-end gap-[72px] mb-[38px] max-[900px]:grid-cols-1 max-[900px]:gap-6 [@media(min-width:901px)_and_(max-height:850px)]:mb-7">

      <div class="max-w-[760px]">
        <span class="mb-4 block text-[10px] font-bold leading-none tracking-[0.08em] text-blue">
          POR QUÉ UNYX
        </span>

        <h2 class="text-[clamp(36px,3.2vw,50px)] font-bold leading-[1.04] tracking-[-0.045em] text-white max-[620px]:text-[clamp(36px,10vw,46px)] [@media(min-width:901px)_and_(max-height:850px)]:text-[clamp(34px,3vw,46px)]">
          No empezamos por la herramienta.
          Empezamos por lo que necesitas resolver.
        </h2>
      </div>

      <p class="max-w-[390px] pb-1 text-[13px] leading-[1.6] text-gray-500">
        Combinamos visión de negocio y capacidad técnica para construir
        soluciones que funcionen dentro de la realidad de cada empresa.
      </p>

    </header>

    <div class="grid grid-cols-2 border-l border-t border-gray-800 max-[900px]:grid-cols-1">
      {
        principles.map((principle) => (
          <article class="relative flex min-h-[198px] flex-col justify-between border-b border-r border-gray-800 p-[26px_32px] max-[900px]:min-h-0 max-[620px]:p-[26px_22px] [@media(min-width:901px)_and_(max-height:850px)]:min-h-[175px] [@media(min-width:901px)_and_(max-height:850px)]:p-[22px_28px]">

            <span class="text-[10px] font-bold text-blue">
              {principle.number}
            </span>

            <span
              class="absolute right-7 top-6 text-sm text-gray-600"
              aria-hidden="true"
            >
              +
            </span>

            <div class="mt-[30px] max-w-[500px] max-[620px]:mt-7 [@media(min-width:901px)_and_(max-height:850px)]:mt-[22px]">
              <h3 class="mb-2.5 text-[17px] font-bold leading-[1.25] tracking-[-0.02em] text-white">
                {principle.title}
              </h3>

              <p class="text-xs leading-[1.55] text-gray-500">
                {principle.description}
              </p>
            </div>

          </article>
        ))
      }
    </div>

    <div class="mt-[34px] grid grid-cols-[1fr_minmax(360px,0.8fr)] items-center gap-[50px] max-[900px]:grid-cols-1 [@media(min-width:901px)_and_(max-height:850px)]:mt-6">

      <div
        class="flex items-center gap-3"
        aria-hidden="true"
      >
        <div class="grid grid-cols-[repeat(2,8px)] gap-0.5">
          <span class="h-2 w-2 border border-gray-600 bg-transparent"></span>
          <span class="h-2 w-2 border border-gray-600 bg-transparent"></span>
          <span class="h-2 w-2 border border-gray-600 bg-transparent"></span>
          <span class="h-2 w-2 border border-blue bg-blue"></span>
        </div>

        <small class="text-[7px] font-bold tracking-[0.1em] text-blue">
          UNYX CORE
        </small>
      </div>

      <p class="max-w-[500px] text-[clamp(18px,1.5vw,23px)] font-semibold leading-[1.35] tracking-[-0.025em] text-white">
        UNYX conecta estrategia, tecnología y operación.
      </p>

    </div>

  </div>
</section>
