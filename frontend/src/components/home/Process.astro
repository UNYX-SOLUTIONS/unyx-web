---
const steps = [
  {
    number: "01",
    title: "Entendemos",
    description:
      "Analizamos la operación, los procesos y las necesidades antes de proponer tecnología.",
  },
  {
    number: "02",
    title: "Diseñamos",
    description:
      "Definimos una solución clara, viable y adaptada a la realidad de cada empresa.",
  },
  {
    number: "03",
    title: "Implementamos",
    description:
      "Configuramos, desarrollamos e integramos los componentes necesarios para poner la solución en funcionamiento.",
  },
  {
    number: "04",
    title: "Acompañamos",
    description:
      "Apoyamos la adopción, evolución y mejora de la solución después de su implementación.",
  },
];
---

<section class="w-full bg-white text-black" id="como-trabajamos">
  <div class="mx-auto w-full max-w-[1440px] px-[clamp(32px,5vw,64px)] pt-[46px] pb-[72px] max-[900px]:px-7 max-[900px]:pt-11 max-[900px]:pb-[68px] max-[620px]:px-5 max-[620px]:pt-[42px] max-[620px]:pb-[62px]">

    <header class="grid grid-cols-[minmax(0,1.55fr)_minmax(300px,0.65fr)] items-end gap-20 mb-[52px] max-[900px]:grid-cols-1 max-[900px]:gap-7 max-[900px]:mb-12 max-[620px]:mb-11">
      <div class="max-w-[760px]">
        <span class="mb-[22px] block text-[11px] font-bold uppercase tracking-[0.08em] text-blue">
          CÓMO TRABAJAMOS
        </span>

        <h2 class="text-[clamp(40px,3.8vw,58px)] font-bold leading-[1.04] tracking-[-0.045em] text-black">
          Primero entendemos.<br class="max-[620px]:hidden" />
          Después construimos.
        </h2>
      </div>

      <div class="max-w-[400px] pb-1 max-[900px]:max-w-[520px]">
        <p class="text-sm leading-[1.65] text-gray-700">
          Cada proyecto comienza entendiendo la operación, sus necesidades y sus
          restricciones. A partir de ahí definimos la tecnología que realmente
          aporta valor.
        </p>
      </div>
    </header>

    <div class="relative grid grid-cols-4 gap-8 max-[900px]:grid-cols-2 max-[900px]:gap-[46px] max-[620px]:grid-cols-1 max-[620px]:gap-[34px]">

      <div
        class="absolute left-0 right-0 top-[7px] h-px bg-gray-200 max-[900px]:hidden"
        aria-hidden="true"
      >
        <span class="block h-full w-[2%] bg-blue"></span>
      </div>

      {
        steps.map((step, index) => (
          <article class="relative z-[2] max-[620px]:pl-[34px] max-[620px]:before:absolute max-[620px]:before:left-[7px] max-[620px]:before:top-[14px] max-[620px]:before:bottom-[-34px] max-[620px]:before:w-px max-[620px]:before:bg-gray-200 max-[620px]:before:content-[''] max-[620px]:last:before:hidden">

            <div
              class:list={[
                "mb-6 h-[14px] w-[14px] rounded-full border border-gray-200 bg-white max-[620px]:absolute max-[620px]:left-0 max-[620px]:top-0 max-[620px]:m-0",
                index === 0 && "border-4 border-blue",
              ]}
              aria-hidden="true"
            ></div>

            <div class="mb-[18px] flex items-center gap-1.5">
              <span class:list={["text-[11px] font-bold", index === 0 ? "text-blue" : "text-black"]}>
                {step.number}
              </span>

              <span class="text-[10px] text-gray-500">
                —
              </span>

              <h3 class="text-[11px] font-bold uppercase tracking-[0.02em] text-black">
                {step.title}
              </h3>
            </div>

            <p class="max-w-[280px] text-[13px] leading-[1.65] text-gray-700">
              {step.description}
            </p>

          </article>
        ))
      }

    </div>

    <div class="mt-[58px] grid grid-cols-[1fr_minmax(420px,0.8fr)] items-center gap-[30px] max-[900px]:grid-cols-1 max-[900px]:mt-[54px] max-[620px]:mt-12">

      <div
        class="h-px bg-gray-200 max-[900px]:w-full max-[620px]:w-11"
        aria-hidden="true"
      ></div>

      <p class="max-w-[540px] text-[clamp(20px,1.8vw,26px)] font-semibold leading-[1.4] tracking-[-0.025em] text-black max-[620px]:text-[21px]">
        La tecnología es el medio.
        La solución empieza por entender el problema.
      </p>

    </div>

  </div>
</section>
