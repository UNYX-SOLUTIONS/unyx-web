---
import { getCollection } from "astro:content";

const visualModifiers = {
  meditec: "",
  "hse-services":
    "h-[210px] bg-[linear-gradient(30deg,#f3f5f7_12%,transparent_12.5%,transparent_87%,#f3f5f7_87.5%)]",
  sismeing: "h-[180px]",
};

const projects = (await getCollection("projects"))
  .filter((entry) => entry.data.number !== "01")
  .sort((a, b) => a.data.number.localeCompare(b.data.number));
---

<section class="w-full bg-white text-black" id="proyectos">
  <div class="site-container pt-[78px] pb-[42px] max-[620px]:px-5 max-[620px]:pt-[66px] max-[620px]:pb-[34px]">

    <header class="grid grid-cols-[minmax(0,1.55fr)_minmax(280px,0.65fr)] items-end gap-20 mb-[52px] max-[900px]:grid-cols-1 max-[900px]:gap-7">
      <div>
        <span class="mb-6 block text-[11px] font-bold tracking-[0.08em] text-blue">
          TRABAJO REAL
        </span>

        <h2 class="max-w-[850px] text-[clamp(38px,3.5vw,54px)] leading-[1.05] tracking-[-0.04em] text-black">
          Tecnología aplicada en contextos reales.
        </h2>
      </div>

      <p class="max-w-[390px] text-sm leading-[1.65] text-gray-600">
        Cada proyecto parte de una necesidad diferente. Nuestro trabajo es
        entenderla y construir la solución tecnológica adecuada.
      </p>
    </header>

    <div class="grid grid-cols-3 border-t border-gray-200 max-[900px]:grid-cols-1">
      {
        projects.map((project) => (
          <a
            class="group block min-w-0 border-r border-gray-200 p-[28px_24px_34px] text-inherit max-[900px]:border-b max-[900px]:border-l max-[620px]:p-[24px_20px_30px]"
            href={`/proyectos/${project.id}`}
            aria-label={`Ver proyecto ${project.data.client}`}
          >
            <div class="mb-7 flex items-center justify-between text-[11px] font-bold text-blue">
              <span>{project.data.number}</span>
              <span class="text-lg text-gray-400 transition-[color,transform] duration-[180ms] group-hover:translate-x-[3px] group-hover:-translate-y-[3px] group-hover:text-blue" aria-hidden="true">↗</span>
            </div>

            <div
              class:list={[
                "mb-7 flex h-[190px] items-center justify-center overflow-hidden border border-gray-200 bg-gray-100 text-[10px] font-bold tracking-[0.05em] text-gray-400 transition-colors duration-[180ms] group-hover:border-gray-300 max-[620px]:h-[190px]",
                visualModifiers[project.id],
              ]}
            >
              <span>
                PROYECTO / {project.data.client}
              </span>
            </div>

            <h3 class="mb-2 text-[22px] font-bold tracking-[-0.03em] text-black">
              {project.data.client}
            </h3>

            <span class="mb-[18px] block text-[10px] font-bold tracking-[0.04em] text-gray-600">
              {project.data.category}
            </span>

            <p class="max-w-[350px] text-[13px] leading-[1.65] text-gray-600">
              {project.data.description}
            </p>
          </a>
        ))
      }
    </div>

    <div class="flex justify-end pt-[26px]">
      <a href="/proyectos" class="group inline-flex items-center gap-2.5 text-xs font-semibold text-black">
        Ver todos los proyectos
        <span class="transition-transform duration-[180ms] group-hover:translate-x-1" aria-hidden="true">→</span>
      </a>
    </div>

  </div>
</section>
