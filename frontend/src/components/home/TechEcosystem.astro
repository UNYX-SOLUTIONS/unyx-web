---
import { techGroups } from "../../data/technologies";
---

<section class="relative w-full overflow-hidden bg-white text-black" id="ecosistema-tecnologico">
  <div class="mx-auto w-full max-w-[1440px] px-[clamp(32px,5vw,64px)] pt-14 pb-11 max-[900px]:px-7 max-[900px]:py-[58px] max-[620px]:px-5 max-[620px]:py-[54px] max-[390px]:px-[18px] [@media(min-width:901px)_and_(max-height:900px)]:pt-[42px] [@media(min-width:901px)_and_(max-height:900px)]:pb-[34px] [@media(min-width:901px)_and_(max-height:760px)]:pt-[30px] [@media(min-width:901px)_and_(max-height:760px)]:pb-7">

    <header class="grid grid-cols-[minmax(0,1.55fr)_minmax(280px,0.65fr)] items-end gap-[clamp(60px,8vw,120px)] border-b border-gray-200 pb-[34px] max-[900px]:grid-cols-1 max-[900px]:gap-6 [@media(min-width:901px)_and_(max-height:900px)]:pb-7 [@media(min-width:901px)_and_(max-height:760px)]:pb-[22px]">

      <div class="max-w-[780px]">
        <span class="mb-[18px] block text-[10px] font-bold leading-none tracking-[0.08em] text-blue [@media(min-width:901px)_and_(max-height:900px)]:mb-[14px]">
          ECOSISTEMA TECNOLÓGICO
        </span>

        <h2 class="text-[clamp(36px,3.2vw,50px)] font-bold leading-[1.04] tracking-[-0.043em] text-black max-[620px]:text-[clamp(34px,10vw,44px)] [@media(min-width:901px)_and_(max-height:760px)]:text-[clamp(34px,2.8vw,44px)]">
          Trabajamos con la tecnología que
          mejor encaja con cada solución.
        </h2>
      </div>

      <p class="max-w-[380px] text-[13px] leading-[1.65] text-gray-600 max-[900px]:max-w-[520px]">
        Integramos plataformas, servicios y herramientas de distintos
        ecosistemas para construir soluciones adaptadas a cada operación.
      </p>

    </header>

    <div class="w-full">

      {
        techGroups.map((group) => (

          <section class="relative grid min-h-[105px] grid-cols-[170px_100px_minmax(0,1fr)] items-center border-b border-gray-200 max-[900px]:grid-cols-[140px_70px_minmax(0,1fr)] max-[620px]:block max-[620px]:min-h-0 max-[620px]:py-[26px] [@media(min-width:901px)_and_(max-height:900px)]:min-h-[94px] [@media(min-width:901px)_and_(max-height:760px)]:min-h-[82px]">

            <div class="self-center max-[620px]:mb-5">
              <span class="mb-2 block text-[8px] font-semibold leading-none text-gray-500 max-[620px]:mb-[7px]">
                {group.number}
              </span>

              <h3 class="text-[10px] font-bold leading-[1.25] tracking-[0.025em] text-black">
                {group.title}
              </h3>
            </div>

            <div
              class="relative flex w-full items-center pr-0.5 max-[620px]:hidden"
              aria-hidden="true"
            >
              <span class="h-[5px] w-[5px] shrink-0 rounded-full bg-blue"></span>
              <span class="h-px flex-1 bg-linear-to-r from-blue via-[#8eb5ff] to-gray-200"></span>
            </div>

            <div class="group/tools flex min-w-0 flex-wrap items-center gap-x-7 gap-y-3 pl-6 max-[900px]:gap-x-[22px] max-[900px]:pl-[18px] max-[620px]:gap-x-5 max-[620px]:gap-y-[14px] max-[620px]:pl-0 max-[390px]:gap-x-4">

              {
                group.tools.map((tool) => (

                  <div
                    class:list={[
                      "inline-flex min-h-11 items-center gap-[9px] text-black transition-[transform,opacity] duration-[180ms] group-hover/tools:opacity-[0.48] hover:-translate-y-0.5 hover:opacity-100 [@media(min-width:901px)_and_(max-height:760px)]:min-h-[38px] max-[620px]:min-h-9 max-[620px]:gap-2",
                      tool.emphasis && "tool-emphasis",
                    ]}
                  >

                    <div class="flex h-[29px] w-[29px] shrink-0 items-center justify-center [@media(min-width:901px)_and_(max-height:760px)]:h-[26px] [@media(min-width:901px)_and_(max-height:760px)]:w-[26px] max-[620px]:h-[25px] max-[620px]:w-[25px] max-[390px]:h-[23px] max-[390px]:w-[23px]">

                      <img
                        src={tool.logo}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="block h-full w-full object-contain"
                      />

                    </div>

                    <span class:list={["whitespace-nowrap text-base font-medium leading-none text-black max-[900px]:text-sm max-[620px]:text-sm max-[390px]:text-[13px]", tool.emphasis && "text-lg font-bold tracking-[-0.02em] max-[900px]:text-base max-[620px]:text-[15px] max-[390px]:text-sm"]}>
                      {tool.name}
                    </span>

                    {
                      tool.badge && (

                        <span class="ml-0.5 inline-flex items-center gap-[5px] whitespace-nowrap rounded border border-blue/30 bg-gray-100 px-2 py-[5px] text-[8px] font-bold leading-none tracking-[0.06em] text-blue max-[620px]:px-[7px] max-[620px]:py-1 max-[620px]:text-[7px]">

                          <span
                            class="block h-[6px] w-[6px] shrink-0 rounded-full bg-blue max-[620px]:h-[5px] max-[620px]:w-[5px]"
                            aria-hidden="true"
                          ></span>

                          {tool.badge}

                        </span>

                      )
                    }

                  </div>

                ))
              }

            </div>

          </section>

        ))
      }

    </div>

    <div class="flex items-start pt-7 [@media(min-width:901px)_and_(max-height:900px)]:pt-[22px] [@media(min-width:901px)_and_(max-height:760px)]:pt-[18px] max-[620px]:pt-6">

      <p class="max-w-[480px] text-[17px] font-medium leading-[1.45] tracking-[-0.02em] text-black max-[620px]:max-w-[360px] max-[620px]:text-base [@media(min-width:901px)_and_(max-height:760px)]:text-base">
        La herramienta no define la solución.
        La necesidad define la tecnología.
      </p>

    </div>

  </div>
</section>
