---
import { company } from "../../data/company";
---

<section class="relative overflow-hidden bg-black text-white">
  <div class="relative z-[2] mx-auto w-full max-w-[1440px] px-[clamp(32px,5vw,64px)] pt-[170px] pb-[80px]">
    <span class="block text-[11px] font-bold uppercase tracking-[0.08em] text-blue">
      NOSOTROS
    </span>

    <h1 class="mt-6 max-w-[850px] text-[clamp(40px,4.5vw,64px)] font-bold leading-[1.02] tracking-[-0.045em] text-white">
      {company.tagline}
    </h1>

    <p class="mt-6 max-w-[620px] text-base leading-[1.65] text-gray-500">
      {company.description}
    </p>
  </div>
</section>
