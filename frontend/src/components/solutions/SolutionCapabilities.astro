---
const { capabilities = [] } = Astro.props;
---

{
  capabilities.length > 0 && (
    <section class="w-full bg-gray-100 text-black">
      <div class="mx-auto w-full max-w-[1440px] px-[clamp(32px,5vw,64px)] py-[70px]">

        <span class="mb-8 block text-[11px] font-bold uppercase tracking-[0.08em] text-blue">
          CAPACIDADES
        </span>

        <div class="grid grid-cols-3 gap-6 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1">
          {
            capabilities.map((capability) => (
              <article class="rounded-xl border border-gray-200 bg-white p-8">
                <span class="mb-4 block h-[7px] w-[7px] rounded-full bg-blue shadow-[0_0_14px_rgba(0,80,248,0.65)]"></span>

                <p class="text-sm leading-[1.6] text-gray-700">
                  {capability}
                </p>
              </article>
            ))
          }
        </div>

      </div>
    </section>
  )
}
