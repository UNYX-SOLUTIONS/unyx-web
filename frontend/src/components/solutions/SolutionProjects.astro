---
import { getCollection } from "astro:content";
import ProjectCard from "../projects/ProjectCard.astro";
import SectionLabel from "../ui/SectionLabel.astro";

const projects = (await getCollection("projects")).sort((a, b) =>
  a.data.number.localeCompare(b.data.number)
);
---

<section class="w-full bg-white text-black">
  <div class="site-container py-[80px]">

    <SectionLabel class="mb-5">
      PROYECTOS
    </SectionLabel>

    <h2 class="max-w-[760px] text-[clamp(28px,3vw,44px)] font-bold leading-[1.04] tracking-[-0.04em] text-black">
      Tecnología aplicada en contextos reales.
    </h2>

    <div class="mt-12 grid grid-cols-3 gap-6 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1">
      {
        projects.map((entry) => (
          <ProjectCard entry={entry} />
        ))
      }
    </div>

  </div>
</section>
