---
const { service } = Astro.props;
---

<section class="w-full bg-white text-black">
  <div class="mx-auto w-full max-w-[1440px] px-[clamp(32px,5vw,64px)] py-[70px]">

    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-[90px]">
      <span class="block text-[11px] font-bold uppercase tracking-[0.08em] text-blue">
        VISIÓN GENERAL
      </span>

      <div>
        <h2 class="max-w-[720px] text-[clamp(28px,3vw,40px)] font-bold leading-[1.04] tracking-[-0.04em] text-black">
          {service.title}
        </h2>

        <p class="mt-6 max-w-[620px] text-base leading-[1.65] text-gray-700">
          {service.description}
        </p>

        <p class="mt-5 max-w-[620px] text-sm leading-[1.65] text-gray-600">
          Combinamos diferentes capacidades tecnológicas para diseñar
          soluciones que respondan a la realidad de cada operación.
        </p>
      </div>
    </div>

  </div>
</section>
