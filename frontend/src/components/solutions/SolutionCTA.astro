---
import { CONTACT_CTA } from "../../consts";
---

<section class="relative overflow-hidden bg-black text-white">
  <div class="relative z-[2] site-container py-[90px]">

    <div class="flex flex-col items-start gap-8 md:flex-row md:items-end md:justify-between">
      <div class="max-w-[650px]">
        <span class="block text-[11px] font-bold uppercase tracking-[0.1em] text-blue">
          HABLEMOS
        </span>

        <h2 class="mt-6 text-[clamp(32px,3.5vw,50px)] font-bold leading-none tracking-[-0.05em] text-white">
          ¿Qué quieres resolver?
        </h2>
      </div>

      <a
        href="/contacto"
        class="inline-flex items-center gap-6 rounded-md bg-blue px-6 py-[18px] text-[13px] font-bold text-white transition-[background-color,transform] duration-[180ms] hover:-translate-y-0.5 hover:bg-blue-hover"
      >
        {CONTACT_CTA}
        <span aria-hidden="true">→</span>
      </a>
    </div>

  </div>
</section>
