---
import { company } from "../../data/company";
import SectionLabel from "../ui/SectionLabel.astro";

const steps = company.process;
---

<section class="w-full bg-black text-white">
  <div class="site-container py-[80px]">

    <SectionLabel class="mb-5">
      CÓMO LO HACEMOS
    </SectionLabel>

    <h2 class="max-w-[760px] text-[clamp(28px,3vw,44px)] font-bold leading-[1.04] tracking-[-0.045em] text-white">
      Primero entendemos. Después construimos.
    </h2>

    <div class="mt-12 grid grid-cols-4 gap-8 max-[900px]:grid-cols-2 max-[620px]:grid-cols-1">
      {
        steps.map((step) => (
          <article class="border-t border-gray-800 pt-6">
            <span class="text-[11px] font-bold text-blue">
              {step.number}
            </span>

            <h3 class="mt-3 text-[11px] font-bold uppercase tracking-[0.02em] text-white">
              {step.title}
            </h3>

            <p class="mt-3 max-w-[280px] text-[13px] leading-[1.65] text-gray-500">
              {step.description}
            </p>
          </article>
        ))
      }
    </div>

  </div>
</section>
