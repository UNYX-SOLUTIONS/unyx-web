---
import type { CollectionEntry } from "astro:content";

const { entry } = Astro.props;
---

<a
  href={`/proyectos/${entry.id}`}
  class="group block min-w-0 border border-gray-200 bg-white p-[28px_24px_34px] transition-[border-color,transform,box-shadow] duration-[180ms] hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-[0_10px_30px_rgba(12,20,38,0.045)]"
  aria-label={`Ver proyecto ${entry.data.client}`}
>
  <div class="mb-7 flex items-center justify-between text-[11px] font-bold text-blue">
    <span>{entry.data.number}</span>
    <span class="text-lg text-gray-400 transition-[color,transform] duration-[180ms] group-hover:translate-x-[3px] group-hover:-translate-y-[3px] group-hover:text-blue" aria-hidden="true">↗</span>
  </div>

  {
    entry.data.image ? (
      <img
        src={entry.data.image}
        alt=""
        loading="lazy"
        decoding="async"
        width="800"
        height="500"
        class="mb-7 aspect-[8/5] w-full border border-gray-200 object-cover"
      />
    ) : (
      <div class="mb-7 flex h-[170px] items-center justify-center overflow-hidden border border-gray-200 bg-gray-100 text-[10px] font-bold tracking-[0.05em] text-gray-600">
        <span>
          PROYECTO / {entry.data.client}
        </span>
      </div>
    )
  }

  <h3 class="mb-2 text-[22px] font-bold tracking-[-0.03em] text-black">
    {entry.data.client}
  </h3>

  <span class="mb-[18px] block text-[10px] font-bold tracking-[0.04em] text-gray-600">
    {entry.data.category}
  </span>

  <p class="max-w-[350px] text-[13px] leading-[1.65] text-gray-600">
    {entry.data.description}
  </p>
</a>
