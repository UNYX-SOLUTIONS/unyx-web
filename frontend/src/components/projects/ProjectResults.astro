---
const { content = "" } = Astro.props;
---

{
  content && (
    <section class="w-full bg-white text-black">
      <div class="mx-auto w-full max-w-[1440px] px-[clamp(32px,5vw,64px)] py-[70px]">

        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-[90px]">
          <span class="block text-[11px] font-bold uppercase tracking-[0.08em] text-blue">
            RESULTADOS
          </span>

          <p class="max-w-[640px] text-[clamp(20px,1.8vw,26px)] font-semibold leading-[1.4] tracking-[-0.025em] text-black">
            {content}
          </p>
        </div>

      </div>
    </section>
  )
}
